# Free key from https://api.nasa.gov (DEMO_KEY works but is heavily rate limited)
NASA_API_KEY=DEMO_KEY

# Optional: enables AI-written briefings. Leave empty to use the rule-based summary.
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="gpt-4o-mini
EMBED_BACKEND = "1"

# Optional overrides
# API_URL=http://127.0.0.1:8000
# DB_PATH=data/asteroid_radar.db
